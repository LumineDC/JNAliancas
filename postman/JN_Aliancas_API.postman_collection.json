{
  "info": {
    "name": "JN Alianças - API Etapa 9",
    "description": "Testes de API para cadastro e consulta dos módulos JN Alianças. Execute em banco de teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type":"basic","basic":[{"key":"username","value":"{{apiUser}}","type":"string"},{"key":"password","value":"{{apiPassword}}","type":"string"}]},
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"apiUser","value":"admin"},
    {"key":"apiPassword","value":"123456"},
    {"key":"clienteId","value":""},
    {"key":"produtoId","value":""},
    {"key":"pedidoId","value":""},
    {"key":"pagamentoId","value":""},
    {"key":"entregaId","value":""},
    {"key":"agendamentoId","value":""}
  ],
  "item": [
    {"name":"01 - GET sessão autenticada (200)","request":{"method":"GET","url":"{{baseUrl}}/api/sessao"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('Retorna usuário autenticado', () => pm.expect(pm.response.json().usuario).to.eql(pm.collectionVariables.get('apiUser')));"]}}]},
    {"name":"02 - GET clientes (200)","request":{"method":"GET","url":"{{baseUrl}}/api/registros/clientes"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}]},
    {"name":"03 - GET produtos (200)","request":{"method":"GET","url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('Retorna uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}]},
    {"name":"04 - POST cliente (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"Cliente Postman\", \"nascimento\": \"12/05/1990\", \"cpf\": \"123.456.789-09\", \"telefone\": \"+55 (27) 99999-1234\", \"rua\": \"das Flores\", \"numero\": \"120\", \"bairro\": \"Centro\", \"cidade\": \"Vitória\", \"estado\": \"ES\", \"cep\": \"29000-000\", \"complemento\": \"\"\n}"},"url":"{{baseUrl}}/api/registros/clientes"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('clienteId', pm.response.json().id);"]}}]},
    {"name":"05 - POST produto (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"Produto Postman\", \"material\": \"Ouro 18k\", \"quantidade\": \"10\", \"preco\": \"1200.00\", \"categoria\": \"Aliança\", \"observacoes\": \"\"\n}"},"url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('produtoId', pm.response.json().id);"]}}]},
    {"name":"06 - GET produto criado (200)","request":{"method":"GET","url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('Produto criado aparece na lista', () => pm.expect(pm.response.json().some(x => x.nome === 'Produto Postman')).to.eql(true));"]}}]},
    {"name":"07 - POST pedido (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cliente\": \"Cliente Postman\", \"produto\": \"Produto Postman\", \"quantidade\": \"2\", \"data\": \"12/10/2026\", \"observacoes\": \"Teste API\", \"concluido\": \"Não\", \"total\": \"2400.00\"\n}"},"url":"{{baseUrl}}/api/registros/pedidos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('pedidoId', pm.response.json().id);"]}}]},
    {"name":"07a - GET estoque após pedido (quantidade 8)","request":{"method":"GET","url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('Estoque baixou duas unidades', () => { const p=pm.response.json().find(x=>String(x.id)===String(pm.collectionVariables.get('produtoId'))); pm.expect(p.quantidade).to.eql('8'); });"]}}]},
    {"name":"08 - PUT pedido (200)","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cliente\": \"Cliente Postman\", \"produto\": \"Produto Postman\", \"quantidade\": \"2\", \"data\": \"12/10/2026\", \"observacoes\": \"Pedido atualizado\", \"concluido\": \"Sim\", \"total\": \"2400.00\"\n}"},"url":"{{baseUrl}}/api/registros/pedidos/{{pedidoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('Observação atualizada', () => pm.expect(pm.response.json().observacoes).to.eql('Pedido atualizado'));"]}}]},
    {"name":"09 - POST produto inválido (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"Preço incorreto\", \"material\": \"Ouro\", \"quantidade\": \"1\", \"preco\": \"abc\", \"categoria\": \"Teste\"\n}"},"url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]}}]},
    {"name":"10 - PUT sem autenticação (401)","request":{"auth":{"type":"noauth"},"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"Produto Postman\", \"material\": \"Ouro 18k\", \"quantidade\": \"10\", \"preco\": \"1200.00\", \"categoria\": \"Aliança\", \"observacoes\": \"\"\n}"},"url":"{{baseUrl}}/api/registros/produtos/{{produtoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]}}]},
    {"name":"11 - POST pagamento (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cliente\": \"Cliente Postman\", \"valor\": \"150.00\", \"tipo\": \"Pix\", \"pago\": \"100.00\"\n}"},"url":"{{baseUrl}}/api/registros/pagamentos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.test('Pendente calculado no servidor', () => pm.expect(pm.response.json().pendente).to.eql('50.00'));","pm.collectionVariables.set('pagamentoId', pm.response.json().id);"]}}]},
    {"name":"12 - POST entrega (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cliente\": \"Cliente Postman\", \"tipo\": \"Envio\", \"frete\": \"25.50\", \"prazo\": \"2 dias úteis\", \"observacoes\": \"\"\n}"},"url":"{{baseUrl}}/api/registros/entregas"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('entregaId', pm.response.json().id);"]}}]},
    {"name":"13 - POST agendamento (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"cliente\": \"Cliente Postman\", \"data\": \"15/12/2026\", \"hora\": \"14:30\", \"observacoes\": \"Teste API\"\n}"},"url":"{{baseUrl}}/api/registros/agendamentos"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 201', () => pm.response.to.have.status(201));","pm.collectionVariables.set('agendamentoId', pm.response.json().id);"]}}]},
    {"name":"14 - DELETE pedido (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/pedidos/{{pedidoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]},
    {"name":"14a - GET estoque após exclusão (quantidade 10)","request":{"method":"GET","url":"{{baseUrl}}/api/registros/produtos"},"event":[{"listen":"test","script":{"exec":["pm.test('Estoque foi devolvido', () => { const p=pm.response.json().find(x=>String(x.id)===String(pm.collectionVariables.get('produtoId'))); pm.expect(p.quantidade).to.eql('10'); });"]}}]},
    {"name":"15 - DELETE produto (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/produtos/{{produtoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]},
    {"name":"16 - DELETE pagamento (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/pagamentos/{{pagamentoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]},
    {"name":"17 - DELETE entrega (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/entregas/{{entregaId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]},
    {"name":"18 - DELETE agendamento (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/agendamentos/{{agendamentoId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]},
    {"name":"19 - DELETE cliente (204)","request":{"method":"DELETE","url":"{{baseUrl}}/api/registros/clientes/{{clienteId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]}}]}
  ]
}
